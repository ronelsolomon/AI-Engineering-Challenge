# Required: Twilio for telephony (paid, but challenge reimburses up to $20)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_twilio_number

# LLM Providers (at least one required; free options available)
# Option 1: Groq (FREE, no credit card, 30 RPM, 14,400 req/day)
GROQ_API_KEY=your_groq_key
# Option 2: HuggingFace (FREE, $0.10/month credits)
HF_TOKEN=your_hf_token
# Option 3: OpenAI (PAID, high quality fallback)
OPENAI_API_KEY=your_openai_key

# TTS Providers (free options available)
# Option 1: Edge-TTS (FREE, no key needed, requires: pip install edge-tts)
# Option 2: gTTS (FREE, no key needed, requires: pip install gtts)
# Option 3: pyttsx3 (FREE, offline, requires: pip install pyttsx3)
# Option 4: OpenAI TTS (PAID, best quality, requires OPENAI_API_KEY)
DEEPGRAM_API_KEY=your_deepgram_key

# Tunnel Providers (free options available)
# Option 1: Cloudflare Tunnel (FREE, no auth needed, requires: brew install cloudflared)
# Option 2: Ngrok (FREE tier, requires auth token)
NGROK_AUTH_TOKEN=your_ngrok_token

# Server
SERVER_HOST=localhost
SERVER_PORT=8000
TEST_TARGET_NUMBER=+18054398008
