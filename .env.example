# =============================================================================
# REQUIRED: Twilio telephony (paid, but challenge reimburses up to $20)
# Get from https://console.twilio.com
# =============================================================================
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_twilio_number

# =============================================================================
# LLM - SET AT LEAST ONE (free options available)
# =============================================================================
# Option A: Groq (RECOMMENDED - FREE, no credit card, 14,400 req/day)
# Sign up at https://console.groq.com (instant approval, no card needed)
GROQ_API_KEY=gsk_your_groq_key_here

# Option B: HuggingFace (FREE, $0.10/month credits)
# Sign up at https://huggingface.co/settings/tokens
#HF_TOKEN=hf_your_huggingface_token

# Option C: OpenAI (PAID, best quality, use as last resort)
#OPENAI_API_KEY=sk-your-openai-key

# =============================================================================
# TTS - NO API KEYS NEEDED for free options!
# Just install the Python packages (see requirements.txt)
# Free options: Edge-TTS, gTTS, pyttsx3 (offline)
# Paid option: OpenAI TTS (requires OPENAI_API_KEY above)
# =============================================================================
#DEEPGRAM_API_KEY=your_deepgram_key  # Optional, not used in free mode

# =============================================================================
# TUNNEL - Cloudflare Quick Tunnel needs NO auth token (recommended)
# Just install: brew install cloudflared
# Ngrok free tier needs an auth token from https://dashboard.ngrok.com
# =============================================================================
#NGROK_AUTH_TOKEN=your_ngrok_token

# =============================================================================
# Server settings
# =============================================================================
SERVER_HOST=localhost
SERVER_PORT=8000
# PUBLIC_URL must be set to your tunnel/public URL so Twilio can fetch audio
# Example: https://abc123.trycloudflare.com
PUBLIC_URL=http://localhost:8000
TEST_TARGET_NUMBER=+18054398008
